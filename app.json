{
  "expo": {
    "name": "Coach Kettle",
    "slug": "CoachKettle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coachkettle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coachkettle.coachkettle",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Coach Kettle uses Face ID to keep your workout session secure",
        "NSPhotoLibraryUsageDescription": "Coach Kettle needs access to your photo library to attach gym photos and videos to workouts.",
        "NSCameraUsageDescription": "Coach Kettle needs camera access to take gym photos for your workouts."
      }
    },
    "android": {
      "package": "com.coachkettle.coachkettle",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kettlebell-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/kettlebell-logo.png",
            "backgroundColor": "#151718"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Coach Kettle needs access to your photo library to attach gym photos and videos to workouts.",
          "cameraPermission": "Coach Kettle needs camera access to take gym photos for your workouts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0a7ea4",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4ff8075-fefc-49d1-9a19-2e9b96df2fb0"
      }
    },
    "owner": "aibrah"
  }
}
