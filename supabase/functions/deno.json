{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "lib": ["deno.window"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "importMap": "./import_map.json",
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 4,
    "semiColons": true,
    "singleQuote": false
  }
}
