{
  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Bash(npx expo*)",
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(node -e:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git stash list*)",
      "Bash(supabase migration new *)",
      "Bash(supabase migration list*)",
      "Bash(supabase functions serve*)",
      "Bash(supabase functions list*)",
      "Bash(npx gitnexus*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Read(**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase functions deploy*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/prevent-force-push-main.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-lint.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/warn-direct-db.sh"
          }
        ]
      }
    ]
  }
}
